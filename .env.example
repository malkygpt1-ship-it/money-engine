# Supabase. Use the modern publishable + secret keys when available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Operator/admin security and autonomous ingestion.
ADMIN_PASSWORD=
INGESTION_SECRET=

# Optional direct server-side AI/product generation. The ChatGPT worker plane can operate without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional direct runtime Stripe Checkout. Plugin-native Payment Links can operate without this.
STRIPE_SECRET_KEY=

# Optional legacy compatibility names.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional future direct API integrations. ChatGPT plugin connectors are orchestrated by the worker plane instead.
VIDIQ_API_KEY=
HEYGEN_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
NOTION_TOKEN=
